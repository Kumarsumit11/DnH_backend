generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  role                    Role
  status                  AccountStatus            @default(PENDING_VERIFICATION)
  phone                   String?
  isEmailVerified         Boolean                  @default(false)
  supabaseUserId          String?                  @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  activityLogs            ActivityLog[]
  associatePartnerProfile AssociatePartnerProfile?
  auditLogs               AuditLog[]
  companyProfile          CompanyProfile?
  documents               Document[]
  investorProfile         InvestorProfile?
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  sessions                Session[]
  verifications           Verification[]
  monthlySubmissions      MonthlySubmission[]
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")

  @@index([email])
  @@index([role])
}

model InvestorProfile {
  id                  String               @id @default(uuid())
  accountId           String               @unique
  fullName            String
  address             String?
  investmentRangeMin  Decimal?             @db.Decimal(18, 2)
  investmentRangeMax  Decimal?             @db.Decimal(18, 2)
  preferredIndustries String[]
  bio                 String?
  avatarUrl           String?
  verificationStatus  VerificationStatus   @default(UNVERIFIED)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  investments         Investment[]
  proposals           InvestmentProposal[]
  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model CompanyProfile {
  id                 String       @id @default(uuid())
  accountId          String       @unique
  companyName        String
  companyType        CompanyType?
  registrationNumber String?
  industry           String?
  description        String?
  website            String?
  foundedYear        Int?
  teamSize           Int?
  address            String?
  logoUrl            String?

  gstin          String?
  ceoName        String?
  cfoName        String?
  monthlyRevenue Decimal? @db.Decimal(18, 2)
  yearlyRevenue  Decimal? @db.Decimal(18, 2)

  informationMemo Json?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  rejectionReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account              Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fundingOpportunities FundingOpportunity[]
  financialAnalyses    FinancialAnalysis[]
  updates              CompanyUpdate[]
  fiscalYearConfigs    FiscalYearConfig[]

  @@index([verificationStatus])
  @@index([industry])
}

model CompanyUpdate {
  id         String           @id @default(uuid())
  companyId  String
  authorRole UpdateAuthorRole
  authorName String
  title      String
  content    String
  category   UpdateCategory   @default(GENERAL)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, createdAt])
}

model AssociatePartnerProfile {
  id         String   @id @default(uuid())
  accountId  String   @unique
  fullName   String
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model FundingOpportunity {
  id               String               @id @default(uuid())
  companyId        String
  title            String
  description      String
  fundNeeded       Decimal              @db.Decimal(18, 2)
  fundPurpose      String
  valuation        Decimal?             @db.Decimal(18, 2)
  minimumTicket    Decimal?             @db.Decimal(18, 2)
  equityOfferedPct Decimal?             @db.Decimal(5, 2)
  totalShares      Int?
  pricePerShare    Decimal?             @db.Decimal(18, 2)
  status           FundingStatus        @default(DRAFT)
  rejectionReason  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  company          CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investments      Investment[]
  proposals        InvestmentProposal[]

  @@index([status])
  @@index([companyId])
}

model InvestmentProposal {
  id                   String             @id @default(uuid())
  investorId           String
  fundingOpportunityId String
  proposedAmount       Decimal            @db.Decimal(18, 2)
  sharesRequested      Int?
  message              String?
  status               ProposalStatus     @default(PENDING)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  investment           Investment?
  fundingOpportunity   FundingOpportunity @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  investor             InvestorProfile    @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([investorId, fundingOpportunityId])
  @@index([status])
}

model Investment {
  id                   String              @id @default(uuid())
  investorId           String
  fundingOpportunityId String
  proposalId           String?             @unique
  amount               Decimal             @db.Decimal(18, 2)
  shares               Int?
  status               InvestmentStatus    @default(PENDING)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  fundingOpportunity   FundingOpportunity  @relation(fields: [fundingOpportunityId], references: [id], onDelete: Cascade)
  investor             InvestorProfile     @relation(fields: [investorId], references: [id], onDelete: Cascade)
  proposal             InvestmentProposal? @relation(fields: [proposalId], references: [id])

  @@index([status])
}

model Document {
  id              String         @id @default(uuid())
  accountId       String
  type            DocumentType
  status          DocumentStatus @default(PENDING)
  fileName        String
  fileUrl         String
  mimeType        String
  sizeBytes       Int
  bucket          String
  rejectionReason String?
  reviewedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  account         Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type])
  @@index([status])
}

model Notification {
  id        String           @id @default(uuid())
  accountId String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, isRead])
}

model AuditLog {
  id         String      @id @default(uuid())
  accountId  String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  account    Account?    @relation(fields: [accountId], references: [id])

  @@index([entityType, entityId])
  @@index([accountId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  accountId   String
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Session {
  id         String   @id @default(uuid())
  accountId  String
  userAgent  String?
  ipAddress  String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Verification {
  id        String              @id @default(uuid())
  accountId String
  purpose   VerificationPurpose
  codeHash  String
  expiresAt DateTime
  consumed  Boolean             @default(false)
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now())
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose])
}

model FinancialAnalysis {
  id        String @id @default(uuid())
  companyId String

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  revenue            Float?
  revenueTarget      Float?
  grossProfit        Float?
  operatingProfit    Float?
  netProfitBeforeTax Float?
  operatingExpenses  Float?
  costOfGoodsSold    Float?
  otherIncome        Float?
  financeExpense     Float?

  cashFlow           Float?
  currentRatio       Float?
  inventory          Float?
  accountsReceivable Float?
  totalAssets        Float?
  totalLiabilities   Float?

  shareCapital    Float?
  totalShares     Int?
  sharesSold      Int?
  sharesRemaining Int?

  fundingTarget Float?
  fundingRaised Float?
  investorCount Int?

  profitMargin  Float?
  revenueGrowth Float?

  financialYear Int
  month         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, financialYear, month], name: "companyId_financialYear_month")
  @@index([companyId])
  @@index([companyId, financialYear])
}

model Consultation {
  id               String             @id @default(uuid())
  fullName         String
  email            String
  phone            String
  company          String?
  consultationType ConsultationType
  preferredDate    DateTime
  preferredTime    String
  notes            String?
  status           ConsultationStatus @default(PENDING)
  actionToken      String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([email])
}

model FiscalYearConfig {
  id                   String    @id @default(uuid())
  companyId            String
  fiscalYearLabel      String
  startMonth           MonthEnum
  targetGreenThreshold Decimal   @default(1.00) @db.Decimal(5, 4)
  targetAmberThreshold Decimal   @default(0.90) @db.Decimal(5, 4)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company            CompanyProfile      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products           Product[]
  monthlySubmissions MonthlySubmission[]

  @@unique([companyId, fiscalYearLabel])
}

model IndicatorDefinition {
  id              String          @id @default(uuid())
  code            String          @unique
  label           String
  dashboardScope  DashboardScope
  dataType        DataTypeEnum
  calculationType CalculationType @default(SUM)
  hasTarget       Boolean         @default(false)
  hasLastYear     Boolean         @default(false)
  isFormula       Boolean         @default(false)
  formulaKey      String?
  allowNegative   Boolean         @default(false)
  sortOrder       Int             @default(0)

  indicatorValues IndicatorValue[]
}

model Product {
  id                 String  @id @default(uuid())
  fiscalYearConfigId String
  slot               Int
  name               String?

  fiscalYearConfig FiscalYearConfig @relation(fields: [fiscalYearConfigId], references: [id], onDelete: Cascade)
  indicatorValues  IndicatorValue[]

  @@unique([fiscalYearConfigId, slot])
}

model MonthlySubmission {
  id                 String           @id @default(uuid())
  fiscalYearConfigId String
  month              MonthEnum
  status             SubmissionStatus @default(DRAFT)
  submittedAt        DateTime?
  submittedById      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  fiscalYearConfig FiscalYearConfig @relation(fields: [fiscalYearConfigId], references: [id], onDelete: Cascade)
  submittedBy      Account?         @relation(fields: [submittedById], references: [id])
  indicatorValues  IndicatorValue[]

  @@unique([fiscalYearConfigId, month])
  @@index([fiscalYearConfigId])
}

model IndicatorValue {
  id                    String    @id @default(uuid())
  monthlySubmissionId   String
  indicatorDefinitionId String
  productId             String?
  valueType             ValueType
  value                 Decimal   @db.Decimal(18, 4)

  monthlySubmission   MonthlySubmission   @relation(fields: [monthlySubmissionId], references: [id], onDelete: Cascade)
  indicatorDefinition IndicatorDefinition @relation(fields: [indicatorDefinitionId], references: [id])
  product             Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([monthlySubmissionId, indicatorDefinitionId, productId, valueType])
  @@index([monthlySubmissionId])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  subject    String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   Account @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Account @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, isRead])
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  INVESTOR
  COMPANY
  ASSOCIATE_PARTNER
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CompanyType {
  REAL_ESTATE
  TECHNOLOGY
  MANUFACTURING
  HEALTHCARE
  FINANCE
  OTHER
}

enum FundingStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  CLOSED
  REJECTED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InvestmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DocumentType {
  KYC
  PITCH_DECK
  COMPANY_REGISTRATION
  FINANCIAL_STATEMENT
  LOGO
  AVATAR
  INFORMATION_MEMO
  TALLY_REPORT
  TALLY_EXCEL
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  ACCOUNT
  FUNDING
  PROPOSAL
  INVESTMENT
  DOCUMENT
  SYSTEM
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_OTP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
}

enum ConsultationType {
  DEBT_FUNDING
  EQUITY_INVESTMENT
  WORKING_CAPITAL
  PROJECT_FINANCE
  STRATEGIC_ADVISORY
  PARTNERSHIP
  OTHER
}

enum ConsultationStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum DashboardScope {
  CEO
  CFO
  BOTH
}

enum DataTypeEnum {
  CURRENCY
  PERCENT
  DAYS
  COUNT
  RATIO
}

enum CalculationType {
  SUM
  AVERAGE
  LAST_VALUE
}

enum ValueType {
  ACTUAL
  TARGET
  LAST_YEAR
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
}

enum UpdateAuthorRole {
  CEO
  CFO
}

enum UpdateCategory {
  GENERAL
  FINANCIAL
  PRODUCT
  MILESTONE
  RISK
}

enum MonthEnum {
  JAN
  FEB
  MAR
  APR
  MAY
  JUN
  JUL
  AUG
  SEP
  OCT
  NOV
  DEC
}
